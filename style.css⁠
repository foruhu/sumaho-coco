:root {
    --bg: #0f0f13;
    --surface: #18181b;
    --border: #27272a;
    --text: #f4f4f5;
    --text-muted: #a1a1aa;
    --primary: #9333ea;
    --primary-hover: #7e22ce;
}

body {
    background-color: var(--bg);
    color: var(--text);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    margin: 0;
    padding: 10px;
    box-sizing: border-box;
}

input, select, textarea, button {
    font-family: inherit;
}

h2 {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 1rem;
    margin: 10px 0;
    color: var(--text);
}

.scenario-selector {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 8px 12px;
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 10px;
}

.scenario-selector select {
    background: var(--bg);
    color: var(--text);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 4px 8px;
    flex: 1;
}

.tab-bar {
    display: flex;
    gap: 6px;
    overflow-x: auto;
    margin-bottom: 10px;
    padding-bottom: 4px;
}

.tab-item {
    display: flex;
    align-items: center;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    overflow: hidden;
}

.tab-item.active {
    border-color: var(--primary);
}

.tab-btn {
    background: none;
    border: none;
    color: var(--text);
    padding: 6px 10px;
    font-size: 0.75rem;
    cursor: pointer;
}

.tab-edit-mini {
    background: none;
    border: none;
    padding: 4px 6px;
    cursor: pointer;
    font-size: 0.7rem;
    color: var(--text-muted);
}

.import-section, .scenario-section {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 12px;
    margin-bottom: 12px;
}

.data-io-bar {
    display: flex;
    gap: 8px;
    margin-bottom: 8px;
}

.data-io-bar button, .import-section button {
    cursor: pointer;
}

.grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
    gap: 8px;
    margin-bottom: 12px;
}

.btn {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 8px;
    color: var(--text);
    font-size: 0.75rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
}

.btn:hover {
    border-color: var(--primary);
}

.del-btn {
    background: none;
    border: none;
    color: var(--text-muted);
    cursor: pointer;
    font-size: 0.7rem;
}

.scenario-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.8rem;
    font-weight: bold;
    margin-bottom: 8px;
}

.scenario-search-box input {
    width: 100%;
    background: var(--bg);
    color: var(--text);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 0.75rem;
    box-sizing: border-box;
    margin-bottom: 8px;
}

.scenario-item {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 10px;
    padding-top: 36px;
    margin-bottom: 8px;
    display: flex;
    gap: 8px;
    align-items: flex-start;
    cursor: pointer;
    position: relative;
}

.scenario-item.sent {
    opacity: 0.6;
}

.scenario-actions-top {
    position: absolute;
    top: 6px;
    right: 6px;
    display: flex;
    gap: 3px;
    align-items: center;
    z-index: 2;
    flex-wrap: wrap;
}

.scenario-action-btn, .item-tab-select {
    background: var(--surface);
    color: var(--text);
    border: 1px solid var(--border);
    border-radius: 4px;
    font-size: 0.65rem;
    padding: 2px 5px;
    cursor: pointer;
}

.scenario-del-btn {
    background: none;
    color: #ef4444;
    border: 1px solid #ef4444;
    border-radius: 4px;
    font-size: 0.65rem;
    padding: 2px 5px;
    cursor: pointer;
}

#scenarioIndexBar {
    display: flex;
    gap: 4px;
    flex-wrap: wrap;
    margin-top: 8px;
}

.index-item-group {
    display: inline-flex;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 4px;
    overflow: hidden;
}

.index-add-main-btn, .index-add-sub-btn {
    background: var(--surface);
    color: var(--text);
    border: 1px solid var(--border);
    border-radius: 4px;
    font-size: 0.65rem;
    padding: 3px 6px;
    cursor: pointer;
}

#toast {
    position: fixed;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%) translateY(80px);
    background: #27272a;
    color: #fff;
    padding: 8px 16px;
    border-radius: 6px;
    font-size: 0.75rem;
    opacity: 0;
    transition: all 0.3s ease;
    z-index: 1000;
}

#toast.show {
    transform: translateX(-50%) translateY(0);
    opacity: 1;
}
