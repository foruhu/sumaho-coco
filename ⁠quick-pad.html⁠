<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Sumaho-coco</title>
    <style>
        :root {
            --bg: #121212;
            --surface: #1e1e1e;
            --primary: #bb86fc;
            --accent: #03dac6;
            --text: #e0e0e0;
        }
        body {
            background: var(--bg);
            color: var(--text);
            font-family: sans-serif;
            margin: 0;
            padding: 16px;
        }
        h2 { font-size: 1rem; color: var(--primary); margin-top: 0; }
        .pad-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 10px;
            margin-bottom: 20px;
        }
        .btn {
            background: var(--surface);
            color: var(--text);
            border: 1px solid #333;
            border-radius: 12px;
            padding: 16px 8px;
            font-size: 0.95rem;
            text-align: center;
            touch-action: manipulation;
        }
        .btn:active {
            background: #2a2a2a;
            border-color: var(--accent);
            transform: scale(0.98);
        }
        #toast {
            position: fixed;
            bottom: 20px;
            left: 50%;
            transform: translateX(-50%) translateY(100px);
            background: var(--accent);
            color: #000;
            padding: 12px 24px;
            border-radius: 30px;
            font-weight: bold;
            transition: transform 0.25s ease-out;
            z-index: 999;
        }
        #toast.show { transform: translateX(-50%) translateY(0); }
    </style>
</head>
<body>

    <h2>📱 Sumaho-coco</h2>
    
    <div class="pad-grid">
        <button class="btn" onclick="send('1d100<=50 心理学')">心理学 (50)</button>
        <button class="btn" onclick="send('1d100<=70 目星')">目星 (70)</button>
        <button class="btn" onclick="send('1d100<=80 聞き耳')">聞き耳 (80)</button>
        <button class="btn" onclick="send('【宣言】移動します')">移動宣言</button>
    </div>

    <div id="toast">コピーしました！</div>

    <script>
        function send(text) {
            navigator.clipboard.writeText(text).then(() => {
                const toast = document.getElementById('toast');
                toast.textContent = `コピー: ${text}`;
                toast.classList.add('show');
                setTimeout(() => toast.classList.remove('show'), 1500);
            });
        }
    </script>
</body>
</html>
